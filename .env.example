# Copy to .env at the repo root.

DATABASE_URL=postgres://upskill:upskill@127.0.0.1:5432/upskill
TEST_DATABASE_URL=postgres://upskill:upskill@127.0.0.1:5432/upskill_test
PORT=4000

# Demo clock (optional). The app uses the real date. The seed's last activity
# is 5 Oct 2026, so its learners read as at risk on any later day. Uncomment
# the next line to pin "today" to 6 Oct 2026 and see the seed as the
# screenshots show it.
# AS_OF=2026-10-06T10:00:00+05:30

# Auth stub. The API reads the coach from the X-Coach-Id header and falls back
# to this id. Replace with real sessions before production.
DEFAULT_COACH_ID=coach-meera
