# Copy to .env at the repo root.

# DATABASE_URL=postgres://upskill:upskill@127.0.0.1:5432/upskill
DATABASE_URL=postgres://postgres:himakiran@localhost:5432/upskill
TEST_DATABASE_URL=postgres://postgres:himakiran@localhost:5432/upskill
PORT=4000

# Demo clock. The seed's last activity is 5 Oct 2026, so "today" is pinned to
# the day after. Without this, every seeded learner drifts to at-risk as real
# time passes. Remove the line to use the real clock.
AS_OF=2026-10-06T10:00:00+05:30

# Auth stub. The API reads the coach from the X-Coach-Id header and falls back
# to this id. Replace with real sessions before production.
DEFAULT_COACH_ID=coach-meera
